# docker-compose 使用的环境变量模板
# 复制为 .env 后按需修改；所有值都有默认值，可直接留空使用

# MySQL(默认 root / root123456)
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123456

# Redis
REDIS_PASSWORD=

# MinIO(默认 minioadmin / minioadmin)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# pgvector(默认 postgres / postgres123456)
PG_USERNAME=postgres
PG_PASSWORD=postgres123456

# AI 模型(必填，至少提供聊天用 key)
AI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=

# 嵌入模型(可选，RAG 知识库增强用)
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=

# 邮件(可选)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EXPORT_TO=
MAIL_AGENT_TO=
MAIL_JOB_TO=

# 飞书机器人(可选)
FEISHU_URL=
FEISHU_SECRET=
