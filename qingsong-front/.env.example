# 前端统一后端地址说明（由 src/config/env.js 读取）
# 本地开发推荐走 vite 代理（.env.development 设空），代理目标在 vite.config.js
VITE_API_BASE_URL=http://localhost:8088

# 远程 / 局域网部署时，设为真实可访问的后端地址，例如：
# VITE_API_BASE_URL=https://cjj.edu
# 不设置时默认回退到 http://localhost:8088

# MiMo TTS 语音合成密钥（可选，不填则需在运行时 localStorage('mimo-tts-api-key') 配置）
# VITE_MIMO_TTS_DEFAULT_KEY=
