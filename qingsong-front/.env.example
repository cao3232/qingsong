# 前端统一访问后端的 API 基础地址（被 src/config/env.js 读取）
# 本地开发（前后端分离，后端运行在 8088）：
VITE_API_BASE_URL=http://localhost:8088

# 远程 / 生产部署时，改为真实可访问的后端地址，例如：
# VITE_API_BASE_URL=https://cjj.edu
# 不设置时默认回退到 http://localhost:8088

# MiMo TTS 默认语音 Key（可选；不配置时可在「系统配置 → 音色预设」运行时填入，
# 或用户在浏览器 localStorage 的 mimo-tts-api-key 自行覆盖）
# VITE_MIMO_TTS_DEFAULT_KEY=
